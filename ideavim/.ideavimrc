let g:WhichKeyDesc_git_preview = "<leader>gp Preview hunk"
let g:WhichKeyDesc_git_blame   = "<leader>gbl Blame line"
let g:WhichKeyDesc_git_blametog = "<leader>gB Toggle line blame"
let g:WhichKeyDesc_git_diff    = "<leader>gd Diff this"
let g:WhichKeyDesc_git_hist    = "<leader>gD File History"
let g:WhichKeyDesc_git_push    = "<leader>gP Push"
let g:WhichKeyDesc_git_pull    = "<leader>gl Pull (Update Project)"

let g:WhichKeyDesc_search      = "<leader>s search"
let g:WhichKeyDesc_search_repl = "<leader>sr Search and Replace"
let g:WhichKeyDesc_search_todo = "<leader>st Todo"
let g:WhichKeyDesc_search_todoT = "<leader>sT Todo (all)"

let g:WhichKeyDesc_ui          = "<leader>u ui"
let g:WhichKeyDesc_ui_hints    = "<leader>uh Toggle Inlay Hints"

let g:WhichKeyDesc_diagnostics = "<leader>x diagnostics/quickfix"
let g:WhichKeyDesc_diagnostics_all = "<leader>xx Diagnostics"
let g:WhichKeyDesc_diagnostics_buf = "<leader>xX Buffer Diagnostics"
let g:WhichKeyDesc_diagnostics_qf  = "<leader>xq Quickfix List"
let g:WhichKeyDesc_diagnostics_loc = "<leader>xl Location List"
let g:WhichKeyDesc_diagnostics_todo = "<leader>xt Todos"
let g:WhichKeyDesc_diagnostics_line = "<leader>xd Line Diagnostics"

let g:WhichKeyDesc_diagbuf     = "<leader>D Buffer Diagnostics"
