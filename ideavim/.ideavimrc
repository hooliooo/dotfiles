let g:WhichKeyDesc_code_format = "<leader>cf Format Code"
let g:WhichKeyDesc_code_symb   = "<leader>cs Symbols (Structure)"

let g:WhichKeyDesc_debug       = "<leader>d debug"
let g:WhichKeyDesc_debug_break = "<leader>db Toggle Breakpoint"
let g:WhichKeyDesc_debug_brkls = "<leader>dB View Breakpoints"
