let g:WhichKeyDesc_debug_args  = "<leader>da Run with Args"
let g:WhichKeyDesc_debug_into  = "<leader>di Step Into"
let g:WhichKeyDesc_debug_out   = "<leader>do Step Out"
let g:WhichKeyDesc_debug_over  = "<leader>dO Step Over"
let g:WhichKeyDesc_debug_term  = "<leader>dt Terminate"
let g:WhichKeyDesc_debug_repl  = "<leader>dr REPL"
let g:WhichKeyDesc_debug_ui    = "<leader>du Dap UI"
let g:WhichKeyDesc_debug_eval  = "<leader>de Eval"

let g:WhichKeyDesc_explorer    = "<leader>e File Explorer"
let g:WhichKeyDesc_projectview = "<leader>E Project View"

let g:WhichKeyDesc_find        = "<leader>f file/find"
let g:WhichKeyDesc_find_grep   = "<leader>fg Live Grep"
let g:WhichKeyDesc_find_bufs   = "<leader>fb Buffers"
let g:WhichKeyDesc_find_help   = "<leader>fh Help Tags"
let g:WhichKeyDesc_find_symb   = "<leader>fs Document Symbols"
let g:WhichKeyDesc_find_every  = "<leader>fF Search Everywhere"

let g:WhichKeyDesc_git         = "<leader>g git"
let g:WhichKeyDesc_git_status  = "<leader>gg Git Status (Commit)"
let g:WhichKeyDesc_git_stage   = "<leader>gs Stage hunk"
let g:WhichKeyDesc_git_stagebuf = "<leader>gS Stage buffer"
let g:WhichKeyDesc_git_reset   = "<leader>gr Reset hunk"
